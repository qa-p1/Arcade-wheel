#!/bin/sh
# Project launcher. Dependencies are resolved by the build's RPATH, not by
# changing the desktop environment or inheriting a temporary library path.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$project_dir/build/arcade-wheel" ]; then
    printf '%s\n' 'Build Arcade Wheel first: cmake -S . -B build -DCMAKE_PREFIX_PATH="$PWD/build/localdeps/usr" && cmake --build build' >&2
    exit 1
fi
exec "$project_dir/build/arcade-wheel" "$@"
